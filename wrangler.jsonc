{
  // GlotPic 랜딩 사이트 — 정적 파일만 서빙하는 Worker (Cloudflare Workers Static Assets).
  // 서버 코드(main)는 없다. assets.directory 안의 파일을 그대로 내보낸다.
  // 배포: npx wrangler deploy   (대시보드에서 Git 연결 시 자동 실행)
  "name": "glotpic",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page"
  },
  // 커스텀 도메인. now100k.com 존이 같은 계정에 있어 DNS 레코드도 배포 때 자동으로 잡힌다.
  // glotpic.com 을 등록하면 여기에 한 줄 더 넣으면 된다.
  "routes": [
    { "pattern": "glotpic.now100k.com", "custom_domain": true }
  ]
}
